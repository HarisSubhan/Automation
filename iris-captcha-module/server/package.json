{
  "name": "iris-captcha-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + Socket.IO + Playwright backend that opens FBR IRIS, shows the CAPTCHA to a human over the browser, and completes the verified login.",
  "main": "src/index.js",
